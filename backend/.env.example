# ASP.NET runtime environment; development seeding is prohibited in Production.
ASPNETCORE_ENVIRONMENT=Production
# Listen address inside the API container.
ASPNETCORE_URLS=http://0.0.0.0:8080
# Mongo endpoint WITHOUT database path; use TLS/authenticated Atlas URI for hosted deployment.
Mongo__Uri=mongodb://127.0.0.1:27017/?replicaSet=umrs
# Separate isolated database name.
Mongo__Database=user_management_development
# Finite dependency timeout (seconds, range 1–30).
Mongo__TimeoutSeconds=5
# Dummy documentation values are intentionally rejected. Generate random secrets before use.
Jwt__Secret=dummy-change-me-generate-at-least-32-random-bytes
# Issuer and audience must agree for issuance and verification.
Jwt__Issuer=user-management-api
Jwt__Audience=user-management-client
# Approved access token lifetime; only 15 is accepted.
Jwt__ExpiryMinutes=15
# Independent random 32-byte base64 AES and blind-index HMAC keys; defaults rejected.
Security__IdentifierKey=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
Security__BlindIndexKey=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
# Operator seed is allowed only in Development/Testing. Never set true in Production.
Seed__Enabled=false
# Synthetic development account credentials; values must match operators' configured seed.
Seed__AdminUsername=development.admin
Seed__AdminPassword=dummy-development-admin-password
Seed__UserUsername=development.user
Seed__UserPassword=dummy-development-user-password
# Optional explicit cross-origin development client (same-origin production needs none).
Cors__AllowedOrigins__0=http://127.0.0.1:4200
# Technical logging excludes request bodies, credentials and exception details.
Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft.AspNetCore=Warning
