# Local dev-server proxy only; never bundled into client code.
API_PROXY_TARGET=http://127.0.0.1:5088
# nginx runtime backend host.
BACKEND_ORIGIN=http://backend:8080
# Playwright actual server addresses.
E2E_FRONTEND_URL=http://127.0.0.1:4200
E2E_BACKEND_URL=http://127.0.0.1:5088
# Override test accounts only if matching operator-seeded accounts; otherwise use ignored config.
E2E_USERNAME=development.user
E2E_PASSWORD=dummy-test-secret-replace-before-use
